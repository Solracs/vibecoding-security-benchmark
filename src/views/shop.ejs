<%- include("header") %>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Hacker Shop</h2>
        <div class="alert alert-info d-inline-block px-4">
            <h4 class="mb-0">Wallet Balance: $<%- wallet_balance.toFixed(2) %></h4>
        </div>
        <a href="/dashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>

    <!-- PRODUCT CATALOG -->
    <div class="row">
        <% products.forEach(product => { %>
            <div class="col-md-4">
                <div class="card mb-4 bg-dark text-white border-secondary">
                    <img src="/uploads/<%- product.image %>" class="card-img-top p-3" alt="<%- product.name %>" style="height: 200px; object-fit: contain;">
                    <div class="card-body">
                        <h5 class="card-title text-success"><%- product.name %></h5>
                        <p class="card-text"><small><%- product.description %></small></p>
                        <h4 class="card-text">$<%- product.price.toFixed(2) %></h4>
                        
                        <!-- The target for our LLM implementation -->
                        <form method="POST" action="/cart/add/<%- product.id %>" class="d-flex mt-3">
                            <input type="number" name="quantity" value="1" class="form-control me-2" style="width: 80px;">
                            <button type="submit" class="btn btn-outline-success w-100">Add to Cart</button>
                        </form>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>

    <hr class="my-5">

    <!-- CART DISPLAY -->
    <h3 class="mb-4">Your Cart</h3>
    <% if (cartItems.length === 0) { %>
        <p class="text-muted">Your cart is empty. Time to gear up.</p>
    <% } else { %>
        <ul class="list-group mb-3" style="max-width: 600px;">
            <% let total = 0; %>
            <% cartItems.forEach(item => { %>
                <% total += (item.price * item.quantity); %>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <strong><%- item.name %></strong> <br>
                        <small>Qty: <%- item.quantity %> x $<%- item.price.toFixed(2) %></small>
                    </div>
                    <div class="d-flex align-items-center">
                        <span class="me-3 fw-bold">$<%- (item.price * item.quantity).toFixed(2) %></span>
                        <!-- Removal target for LLM -->
                        <form method="POST" action="/cart/remove/<%- item.cart_item_id %>" class="m-0">
                            <button type="submit" class="btn btn-sm btn-danger">X</button>
                        </form>
                    </div>
                </li>
            <% }) %>
            <li class="list-group-item d-flex justify-content-between text-success bg-light">
                <span><strong>Total (USD)</strong></span>
                <strong>$<%- total.toFixed(2) %></strong>
            </li>
            <form method="POST" action="/cart/checkout" class="mt-4">
                <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">Pay & Checkout</button>
            </form>
        </ul>
    <% } %>
</div>