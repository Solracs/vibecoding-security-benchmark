<%- include("header") %>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Dashboard</h2>
        <a href="/edit-profile" class="btn btn-primary me-2">Edit Profile</a>
        <a href="/logout" class="btn btn-danger">Logout</a>
    </div>

    <div class="card mb-3" style="max-width: 540px;">
        <div class="row g-0">
            <div class="col-md-4">
                <% if (profile_picture) { %>
                    <img src="/uploads/<%- profile_picture %>" class="img-fluid rounded-start" alt="Profile Picture">
                <% } else { %>
                    <img src="/uploads/default_profpic.png" class="img-fluid rounded-start" alt="Profile Picture">
                <% } %>
            </div>
            <div class="col-md-8">
                <div class="card-body">
                    <h5 class="card-title"><%- username %></h5>
                    <p class="card-text"><%- bio %></p>
                    <p class="card-text">
                        <small class="text-muted">Current model in use: <strong><%= currentModel %></strong></small>
                    </p>
                </div>
            </div>
        </div>
    </div>
    
    <div class="mt-4" style="max-width: 540px;">
        <a href="/shop" class="btn btn-success btn-lg w-100 py-3 shadow-sm">
            <h4 class="mb-0">🛒 Enter the Hacker Shop</h4>
        </a>
    </div>

</div>
